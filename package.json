{
  "name": "chat",
  "version": "0.0.1",
  "private": true,
  "description": "Nathan Brodin's portfolio, reimagined as an AI chat.",
  "homepage": "https://chat.brodin.dev",
  "license": "MIT",
  "author": {
    "name": "Nathan Brodin",
    "email": "nathan@brodin.dev",
    "url": "https://brodin.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NathanBrodin/Chat.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "varlock run -- node .output/server/index.mjs",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "env:audit": "varlock audit",
    "env:load": "varlock load",
    "env:codegen": "varlock codegen",
    "prepare": "vp config && vp run env:codegen",
    "db": "varlock run -- drizzle-kit",
    "deps": "vpx taze@latest -Ilw --maturity-period 3",
    "tanstack": "vpx @tanstack/cli@latest",
    "ui": "vpx shadcn@latest",
    "skills": "vpx skills@latest",
    "intent": "vpx @tanstack/intent@latest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.161",
    "@ai-sdk/tool-web-fetch": "1.0.7",
    "@base-ui/react": "1.9.0",
    "@daypicker/react": "10.0.2",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@rive-app/react-webgl2": "4.37.0",
    "@shadcn/react": "0.3.1",
    "@takumi-rs/helpers": "^2.14.0",
    "@tanstack/react-hotkeys": "0.16.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@varlock/vite-integration": "1.5.4",
    "ai": "7.0.157",
    "cal-sans": "2.1.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "evlog": "2.34.0",
    "lucide-react": "1.61.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "schema-dts": "^2.0.0",
    "shadcn": "4.22.1",
    "shiki": "4.5.0",
    "takumi-js": "^2.16.2",
    "varlock": "1.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.2",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-plugin-query": "5.104.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "1.0.0-rc.5",
    "nitro": "3.0.260903-beta",
    "oxc-transform-react": "0.155.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "generator": "create-cove",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
