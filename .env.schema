# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Neon PostgreSQL connection URL. Create a project at https://neon.tech and
# copy the pooled connection string from the project dashboard.
# @required @sensitive @type=url(allowedProtocols=[postgres, postgresql])
# @docs(https://neon.tech/docs/connect/connect-from-any-app)
DATABASE_URL=

# GitHub API token for public repository stats (github stars, chat repo tool).
# A fine-grained token with public-repository read access is enough.
# @required @sensitive
# @docs(https://github.com/settings/personal-access-tokens)
GITHUB_API_TOKEN=

# OpenRouter API key for the chat API route.
# @required @sensitive
# @docs(https://openrouter.ai/docs)
OPENROUTER_API_KEY=

# Upstash Redis credentials for chat rate limiting.
# @required @sensitive @type=url
UPSTASH_REDIS_REST_URL=
# @required @sensitive
UPSTASH_REDIS_REST_TOKEN=
