# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Public origin used by the browser and Better Auth.
# @required @type=url
VITE_BASE_URL=http://localhost:3000

# Neon PostgreSQL connection URL. Create a project at https://neon.tech and
# copy the pooled connection string from the project dashboard.
# @required @sensitive @type=url(allowedProtocols=[postgres, postgresql])
# @docs(https://neon.tech/docs/connect/connect-from-any-app)
DATABASE_URL=

# Better Auth signing secret. Generate one with `vpr auth:secret`.
# @required @sensitive
# @docs(https://better-auth.com/docs/installation)
BETTER_AUTH_SECRET=

# Optional GitHub OAuth application credentials.
# @optional
GITHUB_CLIENT_ID=
# @optional @sensitive
GITHUB_CLIENT_SECRET=

# GitHub API token for public repository stats (github stars, chat repo tool).
# A fine-grained token with public-repository read access is enough.
# @required @sensitive
# @docs(https://github.com/settings/personal-access-tokens)
GITHUB_API_TOKEN=

# Optional Google OAuth application credentials.
# @optional
GOOGLE_CLIENT_ID=
# @optional @sensitive
GOOGLE_CLIENT_SECRET=

# OpenRouter API key for the chat API route.
# @required @sensitive
# @docs(https://openrouter.ai/docs)
OPENROUTER_API_KEY=

# Upstash Redis credentials for chat rate limiting.
# @required @sensitive @type=url
UPSTASH_REDIS_REST_URL=
# @required @sensitive
UPSTASH_REDIS_REST_TOKEN=

# NOTE:
# For OAuth2 apps, set callback/redirect URIs to`http://localhost:3000/api/auth/callback/<provider>`
# e.g. http://localhost:3000/api/auth/callback/google
